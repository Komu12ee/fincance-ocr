# ── Per-pipeline UI server (Node) ─────────────────────────────────────────────
# Copy to `.env`. PORT and FLASK_URL are normally injected by the launcher
# (selection/server/utils/pipelines.js); set them here only for standalone runs.

# Generate a strong random secret, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRY=8h

PORT=3001
FLASK_URL=http://127.0.0.1:5001
NODE_ENV=development

# ── Users (simple username/password login, routes/auth.js) ────────────────────
# Add USER_<NAME>=<bcrypt-hash>. Default below is  admin / StrongPass123
#   node -e "console.log(require('bcryptjs').hashSync('YourPassword', 10))"
USER_ADMIN=$2a$10$LHWiVTG5K4K5FJiddxSQCO1KW2CK3M6bVBLU7I0J52yPIYvrAE0Zm
